# Backend (PLANNER_* avoids colliding with unrelated shell DATABASE_URL)
PLANNER_DATABASE_URL=sqlite:///./backend/data/planner.db
PLANNER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PLANNER_DEBUG=false
PLANNER_APP_NAME=AI Project Planner
PLANNER_SERVE_FRONTEND=true
PLANNER_AGENT_DEMO_MODE=true

# LLM (optional — without key, demo agent handles common RU/EN commands)
# PLANNER_LLM_API_KEY=
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
